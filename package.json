{
  "name": "paseo-hq",
  "version": "1.2.3",
  "description": "Paseo Workspace HQ: projects, sessions, artifacts and team worker monitoring",
  "license": "MIT OR Apache-2.0",
  "author": "GNATOVSKIE",
  "homepage": "https://github.com/gnatovskie/paseo-hq",
  "repository": {
    "type": "git",
    "url": "https://github.com/gnatovskie/paseo-hq.git"
  },
  "bin": {
    "paseo-chat": "./bin/paseo-chat"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "shared",
    "server",
    "client",
    "bin",
    "genui",
    "NOTICE",
    "docs",
    "AGENTS.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:hq && npm run test:limits && npm run test:genui && npm run test:git && npm run test:updates",
    "test:genui": "vitest run shared/genui server/genui client/genui-integration.test.ts --maxWorkers=1 --no-file-parallelism",
    "smoke:genui": "node tests/genui/smoke.mjs",
    "smoke:sessions": "node --test tests/session-settings/smoke.mjs",
    "test:hq": "node --test shared/*.test.mjs server/*.test.mjs client/*.test.mjs",
    "check:genui-client": "node tests/genui/registration.mjs",
    "check:genui-hermes": "node tests/genui/hermes-loaders.mjs",
    "test:git": "vitest run server/git-login.test.ts server/git-repositories.test.ts --maxWorkers=1",
    "smoke:git": "node tests/git/smoke.mjs",
    "test:limits": "vitest run server/gemini-api.test.ts server/gemini-live.test.ts --maxWorkers=1",
    "smoke:limits": "node tests/limits/smoke.mjs",
    "test:updates": "vitest run server/plugin-sync.test.ts client/plugin-sync.test.ts --maxWorkers=1"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@getpaseo/protocol": "0.15.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@getpaseo/plugin": ">=0.15.0",
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "^0.81.0",
    "react-native-web": "^0.21.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11",
    "zod": "^3.22.0 || ^4.0.0"
  }
}
